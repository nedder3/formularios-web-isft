---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="receipt-view" hidden aria-live="polite">
  <div class="framer-shell">
    <div class="framer-card">
      <div class="receipt-banner">
        <div class="receipt-check" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div>
          <h2 id="heading-step-3" tabindex="-1">Inscripción Registrada Oficialmente</h2>
          <p id="receipt-status-subtitle">
            Los datos fueron impactados en la planilla homogénea de tu carrera.
          </p>
        </div>
      </div>

      <!-- Comprobante Institucional con Escudo Oficial -->
      <article class="swiss-ticket" aria-label="Comprobante oficial de inscripción">
        <div class="swiss-ticket-top">
          <div class="swiss-ticket-brand-row">
            <img src={`${baseUrl}/logo-isft191.png`} alt="" class="ticket-logo" width="38" height="38" />
            <div class="swiss-ticket-brand">
              <span class="swiss-kicker">INSTITUTO SUPERIOR DE FORMACIÓN TÉCNICA N° 191 - BAHÍA BLANCA</span>
              <strong>CONSTANCIA DE INSCRIPCIÓN A MESA EXAMINADORA</strong>
            </div>
          </div>
          <span class="swiss-stamp">VERIFICADO SHA-256</span>
        </div>

        <div class="receipt-header">
          <div>
            <span class="receipt-meta-label">CÓDIGO DE COMPROBANTE</span>
            <strong class="receipt-code" id="rec-id">-</strong>
          </div>
          <div class="receipt-date-col">
            <span class="receipt-meta-label">FECHA Y HORA DE REGISTRO</span>
            <strong class="receipt-timestamp" id="rec-fecha">-</strong>
          </div>
        </div>

        <dl class="receipt-grid">
          <div class="receipt-cell">
            <dt>Apellido y Nombre</dt>
            <dd id="rec-nombre">-</dd>
          </div>
          <div class="receipt-cell">
            <dt>Documento (DNI)</dt>
            <dd class="tabular-mono" id="rec-dni">-</dd>
          </div>
          <div class="receipt-cell">
            <dt>Correo Electrónico</dt>
            <dd id="rec-email">-</dd>
          </div>
          <div class="receipt-cell">
            <dt>Teléfono / Cohorte</dt>
            <dd class="tabular-mono" id="rec-tel-cohorte">-</dd>
          </div>
          <div class="receipt-cell full-span">
            <dt>Tecnicatura y Resolución Ministerial</dt>
            <dd id="rec-carrera">-</dd>
          </div>
          <div class="receipt-cell full-span highlight-materia">
            <dt>Asignatura Inscripta</dt>
            <dd id="rec-materia">-</dd>
          </div>
          <div class="receipt-cell">
            <dt>Año del Plan / Condición</dt>
            <dd id="rec-anio-mod">-</dd>
          </div>
          <div class="receipt-cell">
            <dt>Ciclo de Cursada / Cátedra</dt>
            <dd id="rec-cursado-prof">-</dd>
          </div>
        </dl>

        <div class="swiss-ticket-footer">
          <span>Carácter de Declaración Jurada - Secretaría Académica ISFT N° 191</span>
          <span class="tabular-mono">Padrón Homogéneo Oficial</span>
        </div>
      </article>

      <!-- Historial Acumulativo de Mesas en la Sesión -->
      <div class="session-history-bento no-print" id="session-history-box" hidden>
        <div class="session-history-header">
          <div class="session-history-title">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 11l3 3L22 4"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
            <strong>Mesas registradas en esta sesión</strong>
          </div>
          <span class="session-count-badge" id="session-count-badge">1 asignatura</span>
        </div>
        <ul class="session-history-list" id="session-history-list"></ul>
      </div>

      <div class="receipt-actions no-print">
        <button type="button" class="btn btn-primary" id="btn-another-subject">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Inscribirme a otra asignatura</span>
        </button>
        <button type="button" class="btn btn-secondary" id="btn-print">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>Imprimir / Guardar PDF</span>
        </button>
      </div>
    </div>
  </div>
</section>
