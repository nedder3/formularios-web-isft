---
interface Props {
  availableYears: string[];
}

const { availableYears } = Astro.props;
---

<fieldset class="form-step" id="form-step-1">
  <div class="framer-shell">
    <div class="framer-card">
      <div class="step-header">
        <div class="step-header-top">
          <span class="step-pill-tag">
            <span>Paso 1 de 2 - Legajo Estudiantil</span>
          </span>
          <span class="step-req-note">Campos obligatorios (*)</span>
        </div>
        <legend class="step-title" id="heading-step-1" tabindex="-1">
          Identificación Personal del Estudiante
        </legend>
        <p class="step-subtitle">
          Verificá que los datos ingresados coincidan con tu documento y legajo académico.
        </p>
      </div>

      <!-- Bloque 1: Titularidad y Cohorte -->
      <div class="form-section-block">
        <div class="section-block-title">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <circle cx="9" cy="10" r="2"></circle>
            <line x1="15" y1="8" x2="17" y2="8"></line>
            <line x1="15" y1="12" x2="17" y2="12"></line>
            <line x1="7" y1="16" x2="17" y2="16"></line>
          </svg>
          <h3>Titularidad y Cohorte de Ingreso</h3>
        </div>

        <div class="form-grid">
          <div class="field-group full-width">
            <label for="apellidoNombre">
              Apellido y Nombre completo <span class="req" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="apellidoNombre"
              name="apellidoNombre"
              placeholder="Ej: Pérez Juan Ignacio"
              autocomplete="name"
              aria-describedby="hint-apellidoNombre err-apellidoNombre"
              required
            />
            <span class="field-hint" id="hint-apellidoNombre">Sin abreviaturas, tal como figura en el DNI</span>
            <span class="field-inline-error" id="err-apellidoNombre" role="alert" hidden></span>
          </div>

          <div class="field-group">
            <label for="dni">
              Número de DNI <span class="req" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="dni"
              name="dni"
              class="tabular-input"
              inputmode="numeric"
              pattern="[0-9]{7,9}"
              placeholder="43596839"
              aria-describedby="hint-dni err-dni"
              required
            />
            <span class="field-hint" id="hint-dni">7 a 9 dígitos numéricos, sin puntos</span>
            <span class="field-inline-error" id="err-dni" role="alert" hidden></span>
          </div>

          <div class="field-group">
            <label for="cohorte">
              Año de Ingreso (Cohorte) <span class="req" aria-hidden="true">*</span>
            </label>
            <select
              id="cohorte"
              name="cohorte"
              aria-describedby="hint-cohorte err-cohorte"
              required
            >
              <option value="">Seleccionar cohorte...</option>
              {availableYears.map((yr) => <option value={yr}>{yr}</option>)}
            </select>
            <span class="field-hint" id="hint-cohorte">Año de matriculación inicial en la carrera</span>
            <span class="field-inline-error" id="err-cohorte" role="alert" hidden></span>
          </div>
        </div>
      </div>

      <!-- Bloque 2: Contacto Académico -->
      <div class="form-section-block">
        <div class="section-block-title">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <h3>Datos de Contacto y Notificación</h3>
        </div>

        <div class="form-grid">
          <div class="field-group">
            <label for="telefono">
              Teléfono Móvil <span class="req" aria-hidden="true">*</span>
            </label>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              class="tabular-input"
              placeholder="2914058716"
              autocomplete="tel"
              aria-describedby="hint-telefono err-telefono"
              required
            />
            <span class="field-hint" id="hint-telefono">Código de área + número (sin 0 ni 15)</span>
            <span class="field-inline-error" id="err-telefono" role="alert" hidden></span>
          </div>

          <div class="field-group">
            <label for="email">
              Correo Electrónico <span class="req" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="estudiante@dominio.com"
              autocomplete="email"
              aria-describedby="hint-email err-email"
              required
            />
            <span class="field-hint" id="hint-email">Vinculado al comprobante de examen</span>
            <span class="field-inline-error" id="err-email" role="alert" hidden></span>
          </div>
        </div>
      </div>

      <div class="step-error" id="error-step-1" role="alert" hidden></div>

      <div class="step-actions">
        <div class="step-autosave-note">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Recordado localmente para agilizar próximas materias</span>
        </div>
        <button type="button" class="btn btn-primary" id="btn-to-step-2">
          <span>Continuar a Selección de Materia</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</fieldset>
