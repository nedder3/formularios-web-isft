---
---

<aside class="live-summary-shell no-print" id="live-summary-aside" aria-label="Resumen de la inscripción">
  <div class="live-summary-card">
    <div class="live-summary-header">
      <h3>Resumen de Inscripción</h3>
      <p>Verificá los datos declarados antes de confirmar la mesa.</p>
    </div>

    <!-- Bloque 1: Estudiante -->
    <div class="live-section">
      <div class="live-section-head">
        <span>1. Datos del Estudiante</span>
        <span class="live-step-badge" id="live-badge-step1">Pendiente</span>
      </div>
      <dl class="live-dl">
        <div class="live-row">
          <dt>Estudiante</dt>
          <dd id="live-val-nombre" class="is-empty">Sin completar</dd>
        </div>
        <div class="live-row">
          <dt>DNI / Cohorte</dt>
          <dd id="live-val-dni-cohorte" class="is-empty tabular-mono">-</dd>
        </div>
        <div class="live-row">
          <dt>Contacto</dt>
          <dd id="live-val-contacto" class="is-empty">-</dd>
        </div>
      </dl>
    </div>

    <!-- Bloque 2: Mesa Examinadora -->
    <div class="live-section">
      <div class="live-section-head">
        <span>2. Mesa Examinadora</span>
        <span class="live-step-badge" id="live-badge-step2">Pendiente</span>
      </div>
      <dl class="live-dl">
        <div class="live-row">
          <dt>Tecnicatura</dt>
          <dd id="live-val-carrera" class="is-empty">Sin seleccionar</dd>
        </div>
        <div class="live-row">
          <dt>Asignatura</dt>
          <dd id="live-val-materia" class="is-empty">Sin seleccionar</dd>
        </div>
        <div class="live-row">
          <dt>Año y Condición</dt>
          <dd id="live-val-condicion" class="is-empty">-</dd>
        </div>
        <div class="live-row">
          <dt>Cátedra</dt>
          <dd id="live-val-catedra" class="is-empty">-</dd>
        </div>
      </dl>
    </div>

    <div class="live-footer-note">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
      </svg>
      <span>
        Al confirmar se emitirá tu comprobante oficial descargable en PDF.
      </span>
    </div>
  </div>
</aside>

<style>
  .live-summary-shell {
    background: var(--framer-shell-bg);
    border: 1px solid var(--framer-shell-border);
    border-radius: var(--radius-lg);
    padding: 6px;
    position: sticky;
    top: 5.5rem;
  }

  .live-summary-card {
    background: #ffffff;
    border: 1px solid var(--bento-border);
    border-radius: calc(var(--radius-lg) - 5px);
    padding: 1.35rem;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .live-summary-header {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .live-summary-header h3 {
    font-size: 1rem;
    font-weight: 800;
    color: var(--brand-primary);
    letter-spacing: -0.015em;
  }

  .live-summary-header p {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  .live-section {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-sm);
    padding: 0.9rem 1rem;
  }

  .live-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.65rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .live-step-badge {
    font-size: 0.66rem;
    font-weight: 700;
    padding: 0.12rem 0.5rem;
    border-radius: 6px;
    background: #e2e8f0;
    color: #475569;
  }

  .live-step-badge.done {
    background: var(--feedback-success-bg);
    color: var(--feedback-success);
    border: 1px solid #bbf7d0;
  }

  .live-dl {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .live-row {
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
  }

  .live-row dt {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .live-row dd {
    font-size: 0.83rem;
    font-weight: 700;
    color: var(--text-main);
    word-break: break-word;
  }

  .live-row dd.is-empty {
    color: #94a3b8;
    font-weight: 500;
  }

  .live-footer-note {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.74rem;
    color: var(--text-muted);
    background: var(--brand-accent-light);
    border: 1px solid rgba(201, 112, 38, 0.22);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.85rem;
    line-height: 1.4;
  }

  .live-footer-note svg {
    color: var(--brand-accent);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
</style>
