---
import type { ClientCarreraDto } from '../types/academic';

interface Props {
  carreras: ClientCarreraDto[];
  preselectedCarrera: string;
  availableYears: string[];
}

const { carreras, preselectedCarrera, availableYears } = Astro.props;
const normalizedPreselected = preselectedCarrera.trim().toUpperCase();
const activePreselectedCarrera = carreras.find((c) => c.code === normalizedPreselected);
---

<fieldset class="form-step" id="form-step-2" hidden>
  <div class="framer-shell">
    <div class="framer-card">
      <!-- Barra de Contexto de Legajo Activo -->
      <div class="active-student-bar" id="active-student-summary">
        <div class="active-student-info">
          <div class="student-avatar-svg" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div>
            <span class="active-student-label">Legajo Activo</span>
            <div class="active-student-line">
              <strong id="summary-student-name">—</strong>
              <span class="active-student-meta" id="summary-student-meta">DNI — • Cohorte —</span>
            </div>
          </div>
        </div>
        <button type="button" class="btn-edit-student" id="btn-summary-edit">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          <span>Modificar datos</span>
        </button>
      </div>

      <div class="step-header">
        <div class="step-header-top">
          <span class="step-pill-tag">
            <span class="step-pill-dot" aria-hidden="true"></span>
            <span>Paso 2 de 2 • Selección Curricular</span>
          </span>
          <span class="step-req-note">8 Planes • 211 Asignaturas</span>
        </div>
        <legend class="step-title" id="heading-step-2" tabindex="-1">
          Asignatura y Condición de Examen Final
        </legend>
        <p class="step-subtitle">
          Seleccioná tu tecnicatura, el año del plan de estudios y la materia que deseás rendir.
        </p>
      </div>

      <!-- Bloque 1: Cascada Curricular -->
      <div class="form-section-block">
        <div class="section-block-title">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <h3>Padrón Curricular Oficial</h3>
        </div>

        <div class="form-stack">
          <div class="field-group">
            <label for="carreraCode">
              Tecnicatura y Resolución Ministerial <span class="req" aria-hidden="true">*</span>
            </label>
            <select id="carreraCode" name="carreraCode" required>
              <option value="">Seleccionar tecnicatura y resolución...</option>
              {
                carreras.map((c) => (
                  <option
                    value={c.code}
                    selected={normalizedPreselected === c.code}
                  >
                    {c.name} {c.resolution ? `(${c.resolution})` : ''}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="field-group">
            <span class="field-label" id="label-anio-materia">
              Año del Plan de Estudios <span class="req" aria-hidden="true">*</span>
            </span>
            <div
              class="radio-pills"
              id="anio-pills"
              role="radiogroup"
              aria-labelledby="label-anio-materia"
            >
              <label class="pill-option">
                <input type="radio" name="anioMateria" value="1" required />
                <span class="pill-surface">
                  <span class="pill-dot" aria-hidden="true"></span>
                  <span class="pill-title">1° Año (Primero)</span>
                  <span class="pill-badge" id="badge-count-1">
                    {activePreselectedCarrera ? `${activePreselectedCarrera.countsByYear[1]}` : '—'}
                  </span>
                </span>
              </label>
              <label class="pill-option">
                <input type="radio" name="anioMateria" value="2" />
                <span class="pill-surface">
                  <span class="pill-dot" aria-hidden="true"></span>
                  <span class="pill-title">2° Año (Segundo)</span>
                  <span class="pill-badge" id="badge-count-2">
                    {activePreselectedCarrera ? `${activePreselectedCarrera.countsByYear[2]}` : '—'}
                  </span>
                </span>
              </label>
              <label class="pill-option">
                <input type="radio" name="anioMateria" value="3" />
                <span class="pill-surface">
                  <span class="pill-dot" aria-hidden="true"></span>
                  <span class="pill-title">3° Año (Tercero)</span>
                  <span class="pill-badge" id="badge-count-3">
                    {activePreselectedCarrera ? `${activePreselectedCarrera.countsByYear[3]}` : '—'}
                  </span>
                </span>
              </label>
            </div>
          </div>

          <div class="field-group">
            <div class="materia-label-row">
              <label for="materiaCodigo">
                Asignatura a Rendir <span class="req" aria-hidden="true">*</span>
              </label>
              <div class="search-wrapper">
                <svg class="search-icon-svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input
                  type="search"
                  id="materiaSearch"
                  class="materia-search-input"
                  placeholder="Filtrar por nombre..."
                  aria-label="Filtrar materias por nombre"
                  disabled
                />
              </div>
            </div>
            <select
              id="materiaCodigo"
              name="materiaCodigo"
              aria-describedby="materia-count-hint"
              disabled
              required
            >
              <option value="">Primero seleccioná Carrera y Año...</option>
            </select>
            <span class="field-hint" id="materia-count-hint" aria-live="polite">
              Esperando selección de carrera y año...
            </span>
          </div>
        </div>
      </div>

      <!-- Bloque 2: Condición y Cátedra -->
      <div class="form-section-block">
        <div class="section-block-title">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          <h3>Condición de Examen y Cátedra</h3>
        </div>

        <div class="form-grid">
          <div class="field-group full-width">
            <span class="field-label" id="label-modalidad">
              Condición del Estudiante <span class="req" aria-hidden="true">*</span>
            </span>
            <div
              class="radio-pills"
              role="radiogroup"
              aria-labelledby="label-modalidad"
            >
              <label class="pill-option">
                <input type="radio" name="modalidad" value="Regular" checked required />
                <span class="pill-surface">
                  <span class="pill-dot" aria-hidden="true"></span>
                  <span class="pill-title">Alumno Regular</span>
                  <span class="pill-badge">Cursada aprobada</span>
                </span>
              </label>
              <label class="pill-option">
                <input type="radio" name="modalidad" value="Libre" />
                <span class="pill-surface">
                  <span class="pill-dot" aria-hidden="true"></span>
                  <span class="pill-title">Alumno Libre</span>
                  <span class="pill-badge">Escrito y oral</span>
                </span>
              </label>
            </div>
          </div>

          <div class="field-group">
            <label for="anioCursado">
              Año de Cursada <span class="req" aria-hidden="true">*</span>
            </label>
            <select id="anioCursado" name="anioCursado" required>
              <option value="">Seleccionar año...</option>
              {availableYears.map((yr) => <option value={yr}>{yr}</option>)}
            </select>
            <span class="field-hint">Ciclo lectivo en que cursaste la materia</span>
          </div>

          <div class="field-group">
            <label for="profesor">
              Docente de la Cátedra <span class="req" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="profesor"
              name="profesor"
              list="recent-professors-list"
              placeholder="Apellido del docente (Ej: Crivelli)"
              required
            />
            <datalist id="recent-professors-list"></datalist>
            <span class="field-hint">Apellido del profesor titular o de cursada</span>
          </div>
        </div>
      </div>

      <div class="step-error" id="error-step-2" role="alert" hidden></div>

      <div class="step-actions">
        <button type="button" class="btn btn-secondary" id="btn-back-step-1">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Volver a Datos Personales</span>
        </button>
        <button type="submit" class="btn btn-primary" id="btn-submit">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Confirmar Inscripción a Final</span>
        </button>
      </div>
    </div>
  </div>
</fieldset>
