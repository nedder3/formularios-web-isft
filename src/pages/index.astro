---
import Layout from '../layouts/Layout.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import WizardStepper from '../components/WizardStepper.astro';
import StepPersonalData from '../components/StepPersonalData.astro';
import StepSubjectSelection from '../components/StepSubjectSelection.astro';
import ReceiptTicket from '../components/ReceiptTicket.astro';
import { getClientCarrerasDto } from '../lib/academicService';

const carrerasDto = getClientCarrerasDto();
const url = Astro.url;
const preselectedCarrera = url.searchParams.get('carrera') ?? '';
const isEmbed = url.searchParams.get('embed') === '1';

const currentYear = new Date().getFullYear();
const availableYears = Array.from({ length: 12 }, (_, i) => String(currentYear - i));
---

<Layout title="Inscripción a Finales" embed={isEmbed}>
  <NoticeBanner />
  <WizardStepper />

  <div class="wizard-shell" id="form-card">
    <form id="inscripcion-form" novalidate>
      <StepPersonalData availableYears={availableYears} />
      <StepSubjectSelection
        carreras={carrerasDto}
        preselectedCarrera={preselectedCarrera}
        availableYears={availableYears}
      />
    </form>

    <ReceiptTicket />
  </div>

  <script
    type="application/json"
    id="isft-catalog-data"
    set:html={JSON.stringify(carrerasDto)}
  />
</Layout>

<script>
  import type { ClientCarreraDto, InscripcionResult } from '../types/academic';
  import {
    sanitizeDni,
    validateFieldStep1,
    validateStep1Personal,
    validateStep2Academic,
    type Step1Input,
  } from '../lib/validation';

  type WizardStep = 1 | 2 | 3;

  const STORAGE_KEY = 'isft191_student_draft_v1';
  const PROFESSORS_KEY = 'isft191_recent_professors_v1';

  const catalogEl = document.getElementById('isft-catalog-data');
  const carreras: ClientCarreraDto[] = catalogEl?.textContent
    ? JSON.parse(catalogEl.textContent)
    : [];
  const carreraMap = new Map<string, ClientCarreraDto>(
    carreras.map((c) => [c.code.toUpperCase(), c])
  );

  const form = document.getElementById('inscripcion-form') as HTMLFormElement;
  const step1 = document.getElementById('form-step-1') as HTMLFieldSetElement;
  const step2 = document.getElementById('form-step-2') as HTMLFieldSetElement;
  const receiptView = document.getElementById('receipt-view') as HTMLElement;

  const ind1 = document.getElementById('step-indicator-1') as HTMLElement;
  const ind2 = document.getElementById('step-indicator-2') as HTMLElement;
  const ind3 = document.getElementById('step-indicator-3') as HTMLElement;
  const lineFill1 = document.getElementById('step-line-fill-1') as HTMLElement;
  const lineFill2 = document.getElementById('step-line-fill-2') as HTMLElement;

  const errorStep1 = document.getElementById('error-step-1') as HTMLElement;
  const errorStep2 = document.getElementById('error-step-2') as HTMLElement;

  const carreraSelect = document.getElementById('carreraCode') as HTMLSelectElement;
  const materiaSelect = document.getElementById('materiaCodigo') as HTMLSelectElement;
  const materiaSearch = document.getElementById('materiaSearch') as HTMLInputElement;
  const materiaHint = document.getElementById('materia-count-hint') as HTMLElement;
  const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;

  const draftBanner = document.getElementById('draft-restored-banner') as HTMLElement;
  const draftText = document.getElementById('draft-restored-text') as HTMLElement;
  const clearDraftBtn = document.getElementById('btn-clear-draft') as HTMLButtonElement;

  const sessionHistory: Array<{
    comprobanteId: string;
    materiaNombre: string;
    materiaCodigo: string;
    modalidad: string;
  }> = [];

  let currentStep: WizardStep = 1;

  function transitionToStep(target: WizardStep, moveFocus = true): void {
    currentStep = target;

    form.hidden = target === 3;
    step1.hidden = target !== 1;
    step2.hidden = target !== 2;
    receiptView.hidden = target !== 3;

    [ind1, ind2, ind3].forEach((el, idx) => {
      const stepNum = idx + 1;
      el.classList.toggle('active', stepNum === target);
      el.classList.toggle('done', stepNum < target);
      if (stepNum === target) {
        el.setAttribute('aria-current', 'step');
      } else {
        el.removeAttribute('aria-current');
      }
    });

    lineFill1?.classList.toggle('filled', target > 1);
    lineFill2?.classList.toggle('filled', target > 2);

    if (target === 2) {
      updateStudentSummaryPill();
      updateMateriasList();
    }

    if (moveFocus) {
      const headingId = `heading-step-${target}`;
      const headingEl = document.getElementById(headingId);
      headingEl?.focus({ preventScroll: false });
    }
  }

  function getInputEl(id: string): HTMLInputElement | HTMLSelectElement {
    return document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
  }

  function updateStudentSummaryPill(): void {
    const nombre = getInputEl('apellidoNombre').value.trim();
    const dni = sanitizeDni(getInputEl('dni').value);
    const cohorte = getInputEl('cohorte').value;

    const nameEl = document.getElementById('summary-student-name');
    const metaEl = document.getElementById('summary-student-meta');
    if (nameEl) nameEl.textContent = nombre || 'Estudiante';
    if (metaEl) metaEl.textContent = `DNI ${dni || '—'} • Cohorte ${cohorte || '—'}`;
  }

  function setFieldError(field: keyof Step1Input, message: string | null): void {
    const input = document.getElementById(field);
    const errEl = document.getElementById(`err-${field}`);
    if (!input || !errEl) return;

    if (message) {
      input.setAttribute('aria-invalid', 'true');
      errEl.textContent = message;
      errEl.hidden = false;
    } else {
      input.removeAttribute('aria-invalid');
      errEl.textContent = '';
      errEl.hidden = true;
    }
  }

  const step1Fields: (keyof Step1Input)[] = [
    'apellidoNombre',
    'dni',
    'cohorte',
    'telefono',
    'email',
  ];

  for (const field of step1Fields) {
    const el = document.getElementById(field) as HTMLInputElement | null;
    if (!el) continue;

    if (field === 'dni') {
      el.addEventListener('input', () => {
        const cleaned = sanitizeDni(el.value);
        if (el.value !== cleaned) el.value = cleaned;
        if (el.getAttribute('aria-invalid') === 'true') {
          setFieldError('dni', validateFieldStep1('dni', el.value));
        }
      });
    }

    el.addEventListener('blur', () => {
      if (el.value.trim().length > 0) {
        setFieldError(field, validateFieldStep1(field, el.value));
      }
    });

    el.addEventListener('input', () => {
      if (el.getAttribute('aria-invalid') === 'true') {
        setFieldError(field, validateFieldStep1(field, el.value));
      }
    });
  }

  function loadPersonalDraft(): void {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      let restoredAny = false;

      if (data.apellidoNombre) {
        getInputEl('apellidoNombre').value = data.apellidoNombre;
        restoredAny = true;
      }
      if (data.dni) {
        getInputEl('dni').value = sanitizeDni(data.dni);
        restoredAny = true;
      }
      if (data.telefono) getInputEl('telefono').value = data.telefono;
      if (data.email) getInputEl('email').value = data.email;
      if (data.cohorte) getInputEl('cohorte').value = data.cohorte;
      if (data.carreraCode && !carreraSelect.value) {
        carreraSelect.value = data.carreraCode;
      }

      if (restoredAny && draftBanner && draftText) {
        draftText.textContent = `Legajo activo: ${data.apellidoNombre || 'Estudiante'} (DNI ${data.dni || '—'})`;
        draftBanner.hidden = false;
      }
    } catch {}
  }

  function savePersonalDraft(): void {
    try {
      const draft = {
        apellidoNombre: getInputEl('apellidoNombre').value.trim(),
        dni: sanitizeDni(getInputEl('dni').value),
        telefono: getInputEl('telefono').value.trim(),
        email: getInputEl('email').value.trim(),
        cohorte: getInputEl('cohorte').value,
        carreraCode: carreraSelect.value,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
      if (draftBanner && draftText && draft.apellidoNombre) {
        draftText.textContent = `Legajo activo: ${draft.apellidoNombre} (DNI ${draft.dni})`;
        draftBanner.hidden = false;
      }
    } catch {}
  }

  clearDraftBtn?.addEventListener('click', () => {
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {}
    ['apellidoNombre', 'dni', 'telefono', 'email', 'cohorte'].forEach((id) => {
      const el = getInputEl(id);
      if (el) el.value = '';
      setFieldError(id as keyof Step1Input, null);
    });
    if (draftBanner) draftBanner.hidden = true;
    transitionToStep(1);
  });

  function loadRecentProfessors(): void {
    try {
      const raw = sessionStorage.getItem(PROFESSORS_KEY);
      if (!raw) return;
      const list: string[] = JSON.parse(raw);
      const datalist = document.getElementById('recent-professors-list');
      if (!datalist) return;
      datalist.innerHTML = '';
      for (const prof of list) {
        const opt = document.createElement('option');
        opt.value = prof;
        datalist.appendChild(opt);
      }
    } catch {}
  }

  function rememberProfessor(name: string): void {
    try {
      const trimmed = name.trim();
      if (trimmed.length < 2) return;
      const raw = sessionStorage.getItem(PROFESSORS_KEY);
      const list: string[] = raw ? JSON.parse(raw) : [];
      if (!list.includes(trimmed)) {
        list.unshift(trimmed);
        sessionStorage.setItem(PROFESSORS_KEY, JSON.stringify(list.slice(0, 8)));
        loadRecentProfessors();
      }
    } catch {}
  }

  function getSelectedAnio(): 1 | 2 | 3 | null {
    const checked = document.querySelector(
      'input[name="anioMateria"]:checked'
    ) as HTMLInputElement | null;
    if (!checked) return null;
    const val = Number(checked.value);
    return val === 1 || val === 2 || val === 3 ? val : null;
  }

  function updateYearCountBadges(carrera?: ClientCarreraDto): void {
    for (const yr of [1, 2, 3] as const) {
      const badge = document.getElementById(`badge-count-${yr}`);
      if (badge) {
        badge.textContent = carrera ? `${carrera.countsByYear[yr]}` : '—';
      }
    }
  }

  function updateMateriasList(): void {
    const code = carreraSelect.value.trim().toUpperCase();
    const carrera = carreraMap.get(code);
    updateYearCountBadges(carrera);

    const anio = getSelectedAnio();
    const searchQuery = (materiaSearch?.value ?? '').trim().toLowerCase();
    const previousSelection = materiaSelect.value;

    materiaSelect.innerHTML = '';

    if (!carrera || !anio) {
      materiaSelect.disabled = true;
      if (materiaSearch) materiaSearch.disabled = true;
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = !carrera
        ? 'Primero seleccioná tu carrera...'
        : 'Seleccioná el año (1°, 2° o 3°)...';
      materiaSelect.appendChild(opt);
      materiaHint.textContent = 'Esperando selección de carrera y año...';
      return;
    }

    if (materiaSearch) materiaSearch.disabled = false;

    const delAnio = carrera.materias.filter((m) => m.year === anio);
    const filtradas = searchQuery
      ? delAnio.filter(
          (m) =>
            m.name.toLowerCase().includes(searchQuery) ||
            m.code.toLowerCase().includes(searchQuery)
        )
      : delAnio;

    materiaSelect.disabled = false;

    const defaultOpt = document.createElement('option');
    defaultOpt.value = '';
    defaultOpt.textContent =
      filtradas.length > 0
        ? `Seleccionar asignatura de ${anio}° Año (${filtradas.length} habilitadas)...`
        : `Sin coincidencias para "${materiaSearch.value}" en ${anio}° Año`;
    materiaSelect.appendChild(defaultOpt);

    for (const mat of filtradas) {
      const opt = document.createElement('option');
      opt.value = mat.code;
      opt.textContent = mat.name;
      if (mat.code === previousSelection) opt.selected = true;
      materiaSelect.appendChild(opt);
    }

    materiaHint.textContent = searchQuery
      ? `Filtrando ${filtradas.length} de ${delAnio.length} asignaturas de ${anio}° Año (${carrera.name}).`
      : `Padrón activo: ${delAnio.length} asignaturas oficiales de ${anio}° Año (${carrera.resolution ?? 'Vigente'}).`;
  }

  carreraSelect.addEventListener('change', () => {
    if (materiaSearch) materiaSearch.value = '';
    updateMateriasList();
  });

  document.querySelectorAll('input[name="anioMateria"]').forEach((radio) => {
    radio.addEventListener('change', updateMateriasList);
  });

  materiaSearch?.addEventListener('input', updateMateriasList);

  document.getElementById('btn-to-step-2')?.addEventListener('click', () => {
    errorStep1.hidden = true;
    const rawStep1: Step1Input = {
      apellidoNombre: getInputEl('apellidoNombre').value,
      dni: getInputEl('dni').value,
      cohorte: getInputEl('cohorte').value,
      telefono: getInputEl('telefono').value,
      email: getInputEl('email').value,
    };

    const check = validateStep1Personal(rawStep1);
    for (const field of step1Fields) {
      setFieldError(field, check.errors[field] ?? null);
    }

    if (!check.ok || !check.data) {
      errorStep1.textContent = check.firstError ?? 'Revisá los campos marcados en rojo.';
      errorStep1.hidden = false;
      return;
    }

    getInputEl('dni').value = check.data.dni;
    getInputEl('apellidoNombre').value = check.data.apellidoNombre;
    savePersonalDraft();
    transitionToStep(2);
  });

  document.getElementById('btn-back-step-1')?.addEventListener('click', () => {
    transitionToStep(1);
  });

  document.getElementById('btn-summary-edit')?.addEventListener('click', () => {
    transitionToStep(1);
  });

  document.getElementById('step-nav-btn-1')?.addEventListener('click', () => {
    if (currentStep === 2) {
      transitionToStep(1);
    }
  });

  function renderSessionHistory(): void {
    const box = document.getElementById('session-history-box');
    const listEl = document.getElementById('session-history-list');
    const badgeEl = document.getElementById('session-count-badge');
    if (!box || !listEl || !badgeEl || sessionHistory.length === 0) return;

    box.hidden = false;
    badgeEl.textContent =
      sessionHistory.length === 1
        ? '1 asignatura registrada'
        : `${sessionHistory.length} asignaturas registradas`;

    listEl.innerHTML = '';
    for (const item of sessionHistory) {
      const li = document.createElement('li');
      li.className = 'session-history-item';

      const left = document.createElement('span');
      left.textContent = `${item.materiaNombre} — ${item.modalidad}`;

      const right = document.createElement('code');
      right.textContent = item.comprobanteId;

      li.appendChild(left);
      li.appendChild(right);
      listEl.appendChild(li);
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorStep2.hidden = true;

    const modalidadEl = document.querySelector(
      'input[name="modalidad"]:checked'
    ) as HTMLInputElement | null;

    const step2Check = validateStep2Academic({
      carreraCode: carreraSelect.value,
      anioMateria: getSelectedAnio() ?? 0,
      modalidad: modalidadEl ? modalidadEl.value : 'Regular',
      materiaCodigo: materiaSelect.value,
      anioCursado: getInputEl('anioCursado').value,
      profesor: getInputEl('profesor').value,
    });

    if (!step2Check.ok || !step2Check.data) {
      errorStep2.textContent =
        step2Check.firstError ??
        'Completá todos los campos obligatorios de la asignatura y cátedra.';
      errorStep2.hidden = false;
      return;
    }

    savePersonalDraft();
    rememberProfessor(step2Check.data.profesor);

    const payload = {
      apellidoNombre: getInputEl('apellidoNombre').value.trim(),
      dni: sanitizeDni(getInputEl('dni').value),
      telefono: getInputEl('telefono').value.trim(),
      email: getInputEl('email').value.trim(),
      cohorte: getInputEl('cohorte').value,
      ...step2Check.data,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Procesando inscripción...';

    try {
      const response = await fetch('/api/inscripcion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = (await response.json()) as InscripcionResult & { error?: string };
      if (!response.ok || !result.ok) {
        throw new Error(result.error || 'Error al registrar la inscripción.');
      }

      const d = result.datos;
      const setText = (id: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      setText('rec-id', result.comprobanteId);
      setText('rec-fecha', new Date(result.fechaIso).toLocaleString('es-AR'));
      setText('rec-nombre', d.apellidoNombre);
      setText('rec-dni', d.dni);
      setText('rec-email', d.email);
      setText('rec-tel-cohorte', `${d.telefono} • Cohorte ${d.cohorte}`);
      setText('rec-carrera', `${d.carreraNombre} (${d.carreraResolucion})`);
      setText('rec-materia', `${d.materiaNombre} [${d.materiaCodigo}]`);
      setText(
        'rec-anio-mod',
        `${d.anioMateriaLabel} (${d.anioMateria}° Año) — ${d.modalidad}`
      );
      setText('rec-cursado-prof', `Ciclo ${d.anioCursado} • Prof. ${d.profesor}`);

      const subtitleEl = document.getElementById('receipt-status-subtitle');
      if (subtitleEl) {
        subtitleEl.textContent = result.duplicado
          ? 'Se actualizó tu registro previo para esta asignatura en la planilla oficial (sin duplicar filas).'
          : 'Los datos fueron impactados en la planilla homogénea de tu carrera.';
      }

      const dlBtn = document.getElementById(
        'btn-download-excel'
      ) as HTMLAnchorElement | null;
      if (dlBtn) {
        dlBtn.href = `/api/excel/${encodeURIComponent(d.carreraCode)}`;
      }

      const existingIdx = sessionHistory.findIndex(
        (h) => h.materiaCodigo === d.materiaCodigo
      );
      const historyEntry = {
        comprobanteId: result.comprobanteId,
        materiaNombre: d.materiaNombre,
        materiaCodigo: d.materiaCodigo,
        modalidad: d.modalidad,
      };
      if (existingIdx >= 0) {
        sessionHistory[existingIdx] = historyEntry;
      } else {
        sessionHistory.push(historyEntry);
      }
      renderSessionHistory();

      transitionToStep(3);
    } catch (err: unknown) {
      errorStep2.textContent =
        err instanceof Error ? err.message : 'No se pudo procesar la solicitud.';
      errorStep2.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Confirmar Inscripción a Final</span>
      `;
    }
  });

  document.getElementById('btn-another-subject')?.addEventListener('click', () => {
    materiaSelect.value = '';
    if (materiaSearch) materiaSearch.value = '';
    transitionToStep(2);
  });

  document.getElementById('btn-print')?.addEventListener('click', () => {
    window.print();
  });

  loadPersonalDraft();
  loadRecentProfessors();
  updateYearCountBadges(carreraMap.get(carreraSelect.value.trim().toUpperCase()));
</script>

<style is:global>
  .wizard-shell {
    position: relative;
  }

  .form-step {
    border: none;
  }

  .step-header {
    margin-bottom: 1.25rem;
  }

  .step-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .bento-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--brand-primary);
    background: var(--brand-primary-soft);
    border: 1px solid rgba(52, 56, 170, 0.16);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .step-req-note {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .step-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.025em;
    margin-bottom: 0.2rem;
    outline: none;
  }

  .step-subtitle {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  /* Grilla Bento Asimétrica Real (12 Columnas) */
  .bento-grid-asymmetric {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.15rem;
    align-items: stretch;
  }

  .bento-span-7 {
    grid-column: span 7;
  }

  .bento-span-5 {
    grid-column: span 5;
  }

  .bento-cell {
    background: var(--bento-cell-bg);
    border: 1px solid var(--bento-border);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
    box-shadow: var(--glass-shadow);
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .bento-cell:focus-within {
    border-color: rgba(52, 56, 170, 0.35);
    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.04),
      0 12px 28px -6px rgba(52, 56, 170, 0.1);
  }

  .bento-cell-accent {
    border-top: 3px solid var(--brand-primary);
  }

  .bento-cell-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .bento-cell-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--brand-primary-soft);
    color: var(--brand-primary);
    border: 1px solid rgba(52, 56, 170, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cell-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--brand-primary);
  }

  .bento-cell-header h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  /* Barra de Contexto de Legajo Activo en Paso 2 */
  .active-student-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    background: #ffffff;
    border: 1px solid var(--bento-border);
    border-left: 4px solid var(--brand-primary);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.35rem;
    box-shadow: var(--glass-shadow);
  }

  .active-student-info {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .student-avatar-svg {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--brand-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .active-student-label {
    display: block;
    font-size: 0.64rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--brand-primary);
