---
import Layout from '../layouts/Layout.astro';
import { getCarreras } from '../lib/academicService';

const carreras = getCarreras();
const url = Astro.url;
const preselectedCarrera = url.searchParams.get('carrera') ?? '';
const isEmbed = url.searchParams.get('embed') === '1';

const currentYear = new Date().getFullYear();
const availableYears = Array.from({ length: 12 }, (_, i) => String(currentYear - i));
---

<Layout title="Inscripción a Finales" embed={isEmbed}>
  <!-- Aviso Institucional -->
  <section class="notice-banner no-print" aria-label="Instrucciones de inscripción">
    <div class="notice-icon">ℹ️</div>
    <div>
      <strong>Importante:</strong> Debés completar una inscripción <strong>UNA VEZ POR CADA MATERIA</strong> a rendir. Tus datos personales quedarán recordados en tu dispositivo para agilizar la carga si te anotás a más de un examen final.
    </div>
  </section>

  <!-- Indicador de Pasos (UX Wizard) -->
  <nav class="stepper no-print" aria-label="Progreso del formulario">
    <div class="step active" id="step-indicator-1">
      <span class="step-num">1</span>
      <span class="step-label">Datos del Estudiante</span>
    </div>
    <div class="step-line"></div>
    <div class="step" id="step-indicator-2">
      <span class="step-num">2</span>
      <span class="step-label">Carrera y Materia</span>
    </div>
    <div class="step-line"></div>
    <div class="step" id="step-indicator-3">
      <span class="step-num">3</span>
      <span class="step-label">Comprobante</span>
    </div>
  </nav>

  <!-- Tarjeta Principal del Formulario -->
  <div class="card" id="form-card">
    <form id="inscripcion-form" novalidate>
      <!-- PASO 1: IDENTIFICACIÓN DEL ESTUDIANTE -->
      <fieldset class="form-step" id="form-step-1">
        <legend class="step-title">Paso 1: Identificación Personal</legend>
        <p class="step-subtitle">
          Verificá que tus datos coincidan con tu legajo académico.
        </p>

        <div class="form-grid">
          <div class="field-group full-width">
            <label for="apellidoNombre">Apellido y Nombre completo <span class="req">*</span></label>
            <input
              type="text"
              id="apellidoNombre"
              name="apellidoNombre"
              placeholder="Ej: Pérez Juan Ignacio"
              autocomplete="name"
              required
            />
            <span class="field-hint">Tal como figura en tu DNI</span>
          </div>

          <div class="field-group">
            <label for="dni">DNI (sin puntos) <span class="req">*</span></label>
            <input
              type="text"
              id="dni"
              name="dni"
              inputmode="numeric"
              pattern="[0-9]{7,9}"
              placeholder="Ej: 43596839"
              required
            />
            <span class="field-hint">Solo números, de 7 a 9 dígitos</span>
          </div>

          <div class="field-group">
            <label for="cohorte">Cohorte (Año de ingreso) <span class="req">*</span></label>
            <select id="cohorte" name="cohorte" required>
              <option value="">Seleccionar año...</option>
              {
                availableYears.map((yr) => (
                  <option value={yr}>{yr}</option>
                ))
              }
            </select>
            <span class="field-hint">Año en que ingresaste a la carrera</span>
          </div>

          <div class="field-group">
            <label for="telefono">Teléfono / WhatsApp <span class="req">*</span></label>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              placeholder="Ej: 2914058716"
              autocomplete="tel"
              required
            />
            <span class="field-hint">Con código de área, sin 0 ni 15</span>
          </div>

          <div class="field-group">
            <label for="email">Dirección de correo electrónico <span class="req">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="ejemplo@gmail.com"
              autocomplete="email"
              required
            />
            <span class="field-hint">Se enviará copia del comprobante</span>
          </div>
        </div>

        <div class="step-error" id="error-step-1" hidden></div>

        <div class="step-actions">
          <span></span>
          <button type="button" class="btn btn-primary" id="btn-to-step-2">
            Siguiente: Elegir Materia →
          </button>
        </div>
      </fieldset>

      <!-- PASO 2: SELECCIÓN DINÁMICA DE CARRERA, AÑO Y MATERIA -->
      <fieldset class="form-step" id="form-step-2" hidden>
        <legend class="step-title">Paso 2: Selección de Examen Final</legend>
        <p class="step-subtitle">
          Seleccioná tu carrera y el año de la asignatura para filtrar las materias habilitadas.
        </p>

        <div class="form-grid">
          <div class="field-group full-width">
            <label for="carreraCode">Carrera y Plan (Resolución) <span class="req">*</span></label>
            <select id="carreraCode" name="carreraCode" required>
              <option value="">Seleccioná tu carrera...</option>
              {
                carreras.map((c) => (
                  <option
                    value={c.code}
                    selected={preselectedCarrera.toUpperCase() === c.code}
                  >
                    {c.name} {c.resolution ? `(${c.resolution})` : ''}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="field-group">
            <label for="anioMateria">
              Año al que pertenece la materia <span class="req">*</span>
            </label>
            <div class="radio-pills" id="anio-pills">
              <label class="pill-option">
                <input type="radio" name="anioMateria" value="1" required />
                <span>1° Año (Primero)</span>
              </label>
              <label class="pill-option">
                <input type="radio" name="anioMateria" value="2" />
                <span>2° Año (Segundo)</span>
              </label>
              <label class="pill-option">
                <input type="radio" name="anioMateria" value="3" />
                <span>3° Año (Tercero)</span>
              </label>
            </div>
          </div>

          <div class="field-group">
            <label for="modalidad">Modalidad de Examen <span class="req">*</span></label>
            <div class="radio-pills">
              <label class="pill-option">
                <input type="radio" name="modalidad" value="Regular" checked required />
                <span>Regular</span>
              </label>
              <label class="pill-option">
                <input type="radio" name="modalidad" value="Libre" />
                <span>Libre</span>
              </label>
            </div>
          </div>

          <div class="field-group full-width">
            <label for="materiaCodigo">Materia a rendir <span class="req">*</span></label>
            <select id="materiaCodigo" name="materiaCodigo" disabled required>
              <option value="">Primero seleccioná Carrera y Año...</option>
            </select>
            <span class="field-hint" id="materia-count-hint">
              Esperando selección de carrera y año...
            </span>
          </div>

          <div class="field-group">
            <label for="anioCursado">Año de cursado <span class="req">*</span></label>
            <select id="anioCursado" name="anioCursado" required>
              <option value="">Seleccionar año...</option>
              {
                availableYears.map((yr) => (
                  <option value={yr}>{yr}</option>
                ))
              }
            </select>
            <span class="field-hint">Año en que cursaste la materia</span>
          </div>

          <div class="field-group">
            <label for="profesor">Profesor de la cátedra <span class="req">*</span></label>
            <input
              type="text"
              id="profesor"
              name="profesor"
              placeholder="Apellido del docente (Ej: Crivelli)"
              required
            />
            <span class="field-hint">Docente con quien cursaste o titular</span>
          </div>
        </div>

        <div class="step-error" id="error-step-2" hidden></div>

        <div class="step-actions">
          <button type="button" class="btn btn-secondary" id="btn-back-step-1">
            ← Volver a Datos Personales
          </button>
          <button type="submit" class="btn btn-primary" id="btn-submit">
            Confirmar Inscripción a Final
          </button>
        </div>
      </fieldset>
    </form>

    <!-- PASO 3: COMPROBANTE DE INSCRIPCIÓN -->
    <section id="receipt-view" hidden aria-live="polite">
      <div class="receipt-banner">
        <div class="receipt-check">✓</div>
        <div>
          <h2>¡Inscripción Registrada con Éxito!</h2>
          <p>Los datos fueron impactados en la planilla homogénea de tu carrera.</p>
        </div>
      </div>

      <div class="receipt-box">
        <div class="receipt-header">
          <div>
            <span class="receipt-meta-label">CÓDIGO DE TRANSACCIÓN</span>
            <strong class="receipt-code" id="rec-id">—</strong>
          </div>
          <div style="text-align: right;">
            <span class="receipt-meta-label">FECHA Y HORA</span>
            <strong id="rec-fecha">—</strong>
          </div>
        </div>

        <dl class="receipt-grid">
          <div>
            <dt>Apellido y Nombre</dt>
            <dd id="rec-nombre">—</dd>
          </div>
          <div>
            <dt>DNI</dt>
            <dd id="rec-dni">—</dd>
          </div>
          <div>
            <dt>Correo Electrónico</dt>
            <dd id="rec-email">—</dd>
          </div>
          <div>
            <dt>Teléfono / Cohorte</dt>
            <dd id="rec-tel-cohorte">—</dd>
          </div>
          <div class="full-span">
            <dt>Carrera y Resolución</dt>
            <dd id="rec-carrera">—</dd>
          </div>
          <div class="full-span highlight-materia">
            <dt>Materia Inscripta</dt>
            <dd id="rec-materia">—</dd>
          </div>
          <div>
            <dt>Año de la Materia / Modalidad</dt>
            <dd id="rec-anio-mod">—</dd>
          </div>
          <div>
            <dt>Año de Cursado / Profesor</dt>
            <dd id="rec-cursado-prof">—</dd>
          </div>
        </dl>
      </div>

      <div class="receipt-actions no-print">
        <button type="button" class="btn btn-primary" id="btn-another-subject">
          + Inscribirme a otra materia
        </button>
        <button type="button" class="btn btn-secondary" id="btn-print">
          🖨️ Imprimir / Guardar Comprobante PDF
        </button>
        <a id="btn-download-excel" href="#" class="btn btn-outline" download>
          📊 Descargar Excel Homogéneo de la Carrera
        </a>
      </div>
    </section>
  </div>
</Layout>

<script define:vars={{ carreras }}>
  const STORAGE_KEY = 'isft191_student_draft_v1';

  const form = document.getElementById('inscripcion-form');
  const step1 = document.getElementById('form-step-1');
  const step2 = document.getElementById('form-step-2');
  const receiptView = document.getElementById('receipt-view');

  const ind1 = document.getElementById('step-indicator-1');
  const ind2 = document.getElementById('step-indicator-2');
  const ind3 = document.getElementById('step-indicator-3');

  const errorStep1 = document.getElementById('error-step-1');
  const errorStep2 = document.getElementById('error-step-2');

  const carreraSelect = document.getElementById('carreraCode');
  const materiaSelect = document.getElementById('materiaCodigo');
  const materiaHint = document.getElementById('materia-count-hint');
  const submitBtn = document.getElementById('btn-submit');

  // Cargar datos personales guardados localmente para evitar tipeo repetido
  function loadPersonalDraft() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      if (data.apellidoNombre) document.getElementById('apellidoNombre').value = data.apellidoNombre;
      if (data.dni) document.getElementById('dni').value = data.dni;
      if (data.telefono) document.getElementById('telefono').value = data.telefono;
      if (data.email) document.getElementById('email').value = data.email;
      if (data.cohorte) document.getElementById('cohorte').value = data.cohorte;
      if (data.carreraCode && !carreraSelect.value) {
        carreraSelect.value = data.carreraCode;
      }
    } catch {}
  }

  function savePersonalDraft() {
    try {
      const draft = {
        apellidoNombre: document.getElementById('apellidoNombre').value.trim(),
        dni: document.getElementById('dni').value.replace(/\D/g, ''),
        telefono: document.getElementById('telefono').value.trim(),
        email: document.getElementById('email').value.trim(),
        cohorte: document.getElementById('cohorte').value,
        carreraCode: carreraSelect.value,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
    } catch {}
  }

  function getSelectedAnio() {
    const checked = document.querySelector('input[name="anioMateria"]:checked');
    return checked ? Number(checked.value) : null;
  }

  // Filtrado reactivo en cascada: Carrera + Año -> Materias
  function updateMateriasList() {
    const code = carreraSelect.value;
    const anio = getSelectedAnio();

    materiaSelect.innerHTML = '';

    if (!code || !anio) {
      materiaSelect.disabled = true;
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = !code
        ? 'Primero seleccioná tu carrera...'
        : 'Seleccioná el año (1°, 2° o 3°)...';
      materiaSelect.appendChild(opt);
      materiaHint.textContent = 'Esperando selección de carrera y año...';
      return;
    }

    const carrera = carreras.find((c) => c.code === code);
    if (!carrera) return;

    const filtradas = carrera.materias.filter((m) => m.year === anio);
    materiaSelect.disabled = false;

    const defaultOpt = document.createElement('option');
    defaultOpt.value = '';
    defaultOpt.textContent = `Seleccionar materia de ${anio}° Año (${filtradas.length} disponibles)...`;
    materiaSelect.appendChild(defaultOpt);

    for (const mat of filtradas) {
      const opt = document.createElement('option');
      opt.value = mat.code;
      opt.textContent = mat.name;
      materiaSelect.appendChild(opt);
    }

    materiaHint.textContent = `Mostrando ${filtradas.length} materias oficiales de ${anio}° Año para ${carrera.name}.`;
  }

  carreraSelect.addEventListener('change', updateMateriasList);
  document.querySelectorAll('input[name="anioMateria"]').forEach((radio) => {
    radio.addEventListener('change', updateMateriasList);
  });

  // Validación Paso 1
  document.getElementById('btn-to-step-2').addEventListener('click', () => {
    errorStep1.hidden = true;
    const apellidoNombre = document.getElementById('apellidoNombre').value.trim();
    const dni = document.getElementById('dni').value.replace(/\D/g, '');
    const cohorte = document.getElementById('cohorte').value;
    const telefono = document.getElementById('telefono').value.trim();
    const email = document.getElementById('email').value.trim();

    if (apellidoNombre.length < 3) {
      errorStep1.textContent = 'Por favor ingresá tu Apellido y Nombre completo.';
      errorStep1.hidden = false;
      return;
    }
    if (!/^\d{7,9}$/.test(dni)) {
      errorStep1.textContent = 'El DNI debe tener entre 7 y 9 números (sin puntos).';
      errorStep1.hidden = false;
      return;
    }
    if (!cohorte) {
      errorStep1.textContent = 'Seleccioná tu año de ingreso (Cohorte).';
      errorStep1.hidden = false;
      return;
    }
    if (telefono.length < 6) {
      errorStep1.textContent = 'Ingresá un teléfono de contacto válido.';
      errorStep1.hidden = false;
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errorStep1.textContent = 'Ingresá un correo electrónico válido.';
      errorStep1.hidden = false;
      return;
    }

    document.getElementById('dni').value = dni;
    savePersonalDraft();

    step1.hidden = true;
    step2.hidden = false;
    ind1.classList.remove('active');
    ind1.classList.add('done');
    ind2.classList.add('active');
    updateMateriasList();
  });

  document.getElementById('btn-back-step-1').addEventListener('click', () => {
    step2.hidden = true;
    step1.hidden = false;
    ind2.classList.remove('active');
    ind1.classList.remove('done');
    ind1.classList.add('active');
  });

  // Envío SSR al endpoint /api/inscripcion
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorStep2.hidden = true;

    const carreraCode = carreraSelect.value;
    const anioMateria = getSelectedAnio();
    const modalidadEl = document.querySelector('input[name="modalidad"]:checked');
    const modalidad = modalidadEl ? modalidadEl.value : 'Regular';
    const materiaCodigo = materiaSelect.value;
    const anioCursado = document.getElementById('anioCursado').value;
    const profesor = document.getElementById('profesor').value.trim();

    if (!carreraCode || !anioMateria || !materiaCodigo || !anioCursado || profesor.length < 2) {
      errorStep2.textContent = 'Completá todos los campos obligatorios de la materia y cátedra.';
      errorStep2.hidden = false;
      return;
    }

    savePersonalDraft();

    const payload = {
      apellidoNombre: document.getElementById('apellidoNombre').value.trim(),
      dni: document.getElementById('dni').value.replace(/\D/g, ''),
      telefono: document.getElementById('telefono').value.trim(),
      email: document.getElementById('email').value.trim(),
      cohorte: document.getElementById('cohorte').value,
      carreraCode,
      anioMateria,
      modalidad,
      materiaCodigo,
      anioCursado,
      profesor,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Registrando inscripción...';

    try {
      const response = await fetch('/api/inscripcion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json();
      if (!response.ok || !result.ok) {
        throw new Error(result.error || 'Error al registrar la inscripción.');
      }

      // Poblar comprobante
      const d = result.datos;
      document.getElementById('rec-id').textContent = result.comprobanteId;
      document.getElementById('rec-fecha').textContent = new Date(result.fechaIso).toLocaleString('es-AR');
      document.getElementById('rec-nombre').textContent = d.apellidoNombre;
      document.getElementById('rec-dni').textContent = d.dni;
      document.getElementById('rec-email').textContent = d.email;
      document.getElementById('rec-tel-cohorte').textContent = `${d.telefono} (Cohorte ${d.cohorte})`;
      document.getElementById('rec-carrera').textContent = `${d.carreraNombre} (${d.carreraResolucion})`;
      document.getElementById('rec-materia').textContent = `${d.materiaNombre} [${d.materiaCodigo}]`;
      document.getElementById('rec-anio-mod').textContent = `${d.anioMateriaLabel} (${d.anioMateria}° Año) — ${d.modalidad}`;
      document.getElementById('rec-cursado-prof').textContent = `Cursada ${d.anioCursado} • Prof. ${d.profesor}`;

      const dlBtn = document.getElementById('btn-download-excel');
      dlBtn.href = `/api/excel/${encodeURIComponent(d.carreraCode)}`;

      form.hidden = true;
      receiptView.hidden = false;
      ind2.classList.remove('active');
      ind2.classList.add('done');
      ind3.classList.add('active');
    } catch (err) {
      errorStep2.textContent = err.message || 'No se pudo procesar la solicitud.';
      errorStep2.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirmar Inscripción a Final';
    }
  });

  // Inscribir otra materia manteniendo datos del alumno y carrera
  document.getElementById('btn-another-subject').addEventListener('click', () => {
    materiaSelect.value = '';
    document.getElementById('profesor').value = '';
    receiptView.hidden = true;
    form.hidden = false;
    step1.hidden = true;
    step2.hidden = false;
    ind3.classList.remove('active');
    ind2.classList.remove('done');
    ind2.classList.add('active');
    updateMateriasList();
  });

  document.getElementById('btn-print').addEventListener('click', () => {
    window.print();
  });

  loadPersonalDraft();
</script>

<style>
  .notice-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--brand-accent-light);
    border-left: 5px solid var(--brand-accent);
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: #78350f;
  }

  .notice-icon {
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .stepper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #e2e8f0;
    color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .step.active {
    color: var(--brand-primary);
  }

  .step.active .step-num {
    background: var(--brand-primary);
    color: #ffffff;
    box-shadow: 0 0 0 4px rgba(52, 56, 170, 0.15);
  }

  .step.done {
    color: var(--feedback-success);
  }

  .step.done .step-num {
    background: var(--feedback-success);
    color: #ffffff;
  }

  .step-line {
    flex: 1;
    height: 2px;
    background: var(--border-color);
    margin: 0 0.75rem;
  }

  .card {
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    border: 1px solid #e2e8f0;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    padding: 2rem;
  }

  .form-step {
    border: none;
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand-primary);
    margin-bottom: 0.25rem;
  }

  .step-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-group.full-width {
    grid-column: 1 / -1;
  }

  label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .req {
    color: var(--feedback-error);
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  select {
    min-height: 46px;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    border: 1.5px solid var(--border-color);
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--text-main);
    background-color: #ffffff;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: var(--brand-action);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18);
