---
interface Props {
  title: string;
  embed?: boolean;
}

const { title, embed = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} – ISFT N° 191 Bahía Blanca</title>
    <link rel="icon" type="image/png" href="/logo-isft191.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* Paleta Oficial ISFT N° 191 */
        --brand-primary: #3438aa;
        --brand-primary-dark: #24277a;
        --brand-primary-soft: rgba(52, 56, 170, 0.06);
        --brand-action: #3438aa;
        --brand-accent: #c97026;
        --brand-accent-light: #fdf5ed;
        --brand-charcoal: #2d2d2d;

        /* Tokens Framer Double-Bezel */
        --surface-bg: #f8fafc;
        --surface-card: #ffffff;
        --framer-shell-bg: rgba(15, 23, 42, 0.025);
        --framer-shell-border: rgba(15, 23, 42, 0.07);
        --bento-border: rgba(15, 23, 42, 0.08);
        --glass-bg: rgba(255, 255, 255, 0.92);
        --card-shadow: 0 1px 3px rgba(15, 23, 42, 0.04),
          0 10px 28px -6px rgba(15, 23, 42, 0.05);

        /* Tipografía y Semántica */
        --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI',
          sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --text-main: #0f172a;
        --text-muted: #475569;
        --border-color: #cbd5e1;
        --feedback-success: #15803d;
        --feedback-success-bg: #f0fdf4;
        --feedback-error: #dc2626;
        --feedback-error-bg: #fef2f2;
        --radius-sm: 10px;
        --radius-md: 14px;
        --radius-lg: 20px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--surface-bg);
        background-image: radial-gradient(
          at 50% 0%,
          rgba(52, 56, 170, 0.05) 0px,
          transparent 55%
        );
        color: var(--text-main);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      body.is-embed {
        background: transparent;
      }

      /* Cabecera Exclusiva del Módulo de Inscripción a Exámenes */
      .inst-header {
        background: var(--glass-bg);
        backdrop-filter: blur(16px) saturate(180%);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        border-bottom: 4px solid var(--brand-primary);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
        position: sticky;
        top: 0;
        z-index: 40;
      }

      .inst-header-inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0.9rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
      }

      .inst-brand {
        display: flex;
        align-items: center;
        gap: 0.95rem;
      }

      .inst-logo-img {
        width: 50px;
        height: 50px;
        object-fit: contain;
        border-radius: 10px;
        background: #ffffff;
        padding: 2px;
        border: 1px solid rgba(52, 56, 170, 0.15);
        box-shadow: 0 2px 8px rgba(52, 56, 170, 0.08);
        flex-shrink: 0;
      }

      .inst-title-kicker {
        display: block;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--brand-accent);
      }

      .inst-title h1 {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--brand-primary);
        letter-spacing: -0.02em;
        line-height: 1.2;
      }

      .inst-title p {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 500;
      }

      .siu-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: #ffffff;
        color: var(--text-main);
        border: 1px solid var(--bento-border);
        padding: 0.38rem 0.85rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
      }

      .siu-pill-dot {
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: var(--brand-accent);
      }

      .main-container {
        max-width: 1120px;
        margin: 1.5rem auto 3.5rem;
        padding: 0 1.5rem;
      }

      .inst-footer {
        max-width: 1120px;
        margin: 2.5rem auto 2rem;
        padding: 1.25rem 1.5rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: 0.78rem;
      }

      @media (max-width: 768px) {
        .main-container,
        .inst-header-inner,
        .inst-footer {
          padding-left: 1rem;
          padding-right: 1rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background: #ffffff !important;
          background-image: none !important;
        }
        .main-container {
          margin: 0;
          max-width: 100%;
          padding: 0;
        }
      }
    </style>
  </head>
  <body class={embed ? 'is-embed' : ''}>
    {
      !embed && (
        <header class="inst-header no-print">
          <div class="inst-header-inner">
            <div class="inst-brand">
              <img
                src="/logo-isft191.png"
                alt="Escudo ISFT N° 191 Bahía Blanca"
                class="inst-logo-img"
                width="50"
                height="50"
              />
              <div class="inst-title">
                <span class="inst-title-kicker">ISFT N° 191 • Bahía Blanca</span>
                <h1>Inscripción a Mesas de Exámenes Finales</h1>
                <p>Formularios académicos unificados por carrera y resolución</p>
              </div>
            </div>

            <span class="siu-pill">
              <span class="siu-pill-dot" aria-hidden="true" />
              <span>Compatible SIU Guaraní</span>
            </span>
          </div>
        </header>
      )
    }

    <main class="main-container">
      <slot />
    </main>

    {
      !embed && (
        <footer class="inst-footer no-print">
          <p>
            ISFT N° 191 Bahía Blanca • Los datos registrados revisten carácter de Declaración Jurada.
          </p>
          <span>Secretaría Académica</span>
        </footer>
      )
    }
  </body>
</html>
