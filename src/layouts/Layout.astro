---
interface Props {
  title: string;
  embed?: boolean;
}

const { title, embed = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ISFT N° 191 Bahía Blanca</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* Identidad Institucional ISFT N° 191 */
        --brand-primary: #3438aa;
        --brand-primary-dark: #252882;
        --brand-primary-soft: rgba(52, 56, 170, 0.08);
        --brand-action: #2563eb;
        --brand-accent: #d97706;
        --brand-accent-light: #fef3c7;

        /* Tokens Bento Grid & Subtle Liquid Glass */
        --surface-bg: #f1f5f9;
        --surface-mesh: radial-gradient(
            at 0% 0%,
            rgba(52, 56, 170, 0.07) 0px,
            transparent 50%
          ),
          radial-gradient(at 100% 0%, rgba(217, 119, 6, 0.06) 0px, transparent 50%);
        --surface-card: #ffffff;
        --bento-cell-bg: #f8fafc;
        --bento-border: rgba(52, 56, 170, 0.13);
        --glass-bg: rgba(255, 255, 255, 0.84);
        --glass-border: rgba(255, 255, 255, 0.7);
        --glass-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.06),
          0 2px 6px -1px rgba(52, 56, 170, 0.04);

        /* Tipografía y Semántica */
        --font-sans: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --text-main: #0f172a;
        --text-muted: #475569;
        --border-color: #cbd5e1;
        --feedback-success: #16a34a;
        --feedback-success-bg: #f0fdf4;
        --feedback-error: #dc2626;
        --feedback-error-bg: #fef2f2;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 18px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--surface-bg);
        background-image: var(--surface-mesh);
        background-attachment: fixed;
        color: var(--text-main);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      body.is-embed {
        background: transparent;
      }

      .inst-header {
        background: var(--glass-bg);
        backdrop-filter: blur(14px) saturate(160%);
        -webkit-backdrop-filter: blur(14px) saturate(160%);
        border-bottom: 4px solid var(--brand-primary);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
        position: sticky;
        top: 0;
        z-index: 30;
      }

      .inst-topbar {
        background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-primary-dark) 100%);
        color: #ffffff;
        font-size: 0.78rem;
        padding: 0.4rem 1.25rem;
      }

      .inst-topbar-inner {
        max-width: 960px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .inst-header-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 0.9rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .inst-brand {
        display: flex;
        align-items: center;
        gap: 0.9rem;
      }

      .inst-badge {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--brand-primary);
        color: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        border: 2px solid var(--brand-accent);
        box-shadow: 0 4px 12px rgba(52, 56, 170, 0.25);
        flex-shrink: 0;
      }

      .inst-badge span:first-child {
        font-size: 0.65rem;
        letter-spacing: 0.06em;
        color: #fde68a;
      }

      .inst-badge span:last-child {
        font-size: 1.05rem;
        line-height: 1;
      }

      .inst-title h1 {
        font-size: 1.18rem;
        font-weight: 700;
        color: var(--brand-primary);
        letter-spacing: -0.01em;
      }

      .inst-title p {
        font-size: 0.84rem;
        color: var(--text-muted);
      }

      .siu-pill {
        background: var(--brand-accent-light);
        color: #92400e;
        border: 1px solid #fcd34d;
        padding: 0.32rem 0.75rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
      }

      .main-container {
        max-width: 880px;
        margin: 1.6rem auto 3rem;
        padding: 0 1rem;
      }

      .inst-footer {
        max-width: 880px;
        margin: 2rem auto;
        padding: 1.25rem 1rem;
        border-top: 1px solid var(--border-color);
        text-align: center;
        font-size: 0.82rem;
        color: var(--text-muted);
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background: #ffffff !important;
          background-image: none !important;
        }
        .main-container {
          margin: 0;
          max-width: 100%;
          padding: 0;
        }
      }
    </style>
  </head>
  <body class={embed ? 'is-embed' : ''}>
    {
      !embed && (
        <header class="inst-header no-print">
          <div class="inst-topbar">
            <div class="inst-topbar-inner">
              <span>Instituto Superior de Formación Técnica N° 191 — Bahía Blanca</span>
              <span>Portal de Autogestión Académica</span>
            </div>
          </div>
          <div class="inst-header-inner">
            <div class="inst-brand">
              <div class="inst-badge" aria-hidden="true">
                <span>ISFT</span>
                <span>191</span>
              </div>
              <div class="inst-title">
                <h1>Inscripción a Mesas de Exámenes Finales</h1>
                <p>Sistema de registro académico homologado por carrera</p>
              </div>
            </div>
            <span class="siu-pill">Compatible SIU Guaraní</span>
          </div>
        </header>
      )
    }

    <main class="main-container">
      <slot />
    </main>

    {
      !embed && (
        <footer class="inst-footer no-print">
          <p>
            ISFT N° 191 Bahía Blanca • Los datos registrados tienen carácter de Declaración Jurada.
          </p>
        </footer>
      )
    }
  </body>
</html>
