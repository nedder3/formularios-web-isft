---
interface Props {
  title: string;
  embed?: boolean;
}

const { title, embed = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ISFT N° 191 Bahía Blanca</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* Identidad Institucional ISFT N° 191 */
        --brand-primary: #3438aa;
        --brand-primary-dark: #23267a;
        --brand-primary-soft: rgba(52, 56, 170, 0.07);
        --brand-action: #2563eb;
        --brand-accent: #d97706;
        --brand-accent-light: #fef3c7;

        /* Superficies Arquitectónicas Bento + Subtle Glass */
        --surface-bg: #f1f5f9;
        --surface-card: #ffffff;
        --bento-cell-bg: #ffffff;
        --bento-border: rgba(15, 23, 42, 0.09);
        --glass-bg: rgba(255, 255, 255, 0.88);
        --glass-shadow: 0 1px 2px rgba(15, 23, 42, 0.04),
          0 12px 32px -8px rgba(15, 23, 42, 0.06);

        /* Tipografía de Interfaz y Monoespaciada Tabular */
        --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI',
          sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --text-main: #0f172a;
        --text-muted: #475569;
        --border-color: #cbd5e1;
        --feedback-success: #15803d;
        --feedback-success-bg: #f0fdf4;
        --feedback-error: #dc2626;
        --feedback-error-bg: #fef2f2;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--surface-bg);
        background-image: radial-gradient(rgba(52, 56, 170, 0.07) 1px, transparent 1px),
          radial-gradient(at 0% 0%, rgba(52, 56, 170, 0.06) 0px, transparent 45%);
        background-size: 24px 24px, 100% 100%;
        color: var(--text-main);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      body.is-embed {
        background: transparent;
      }

      .inst-header {
        background: var(--glass-bg);
        backdrop-filter: blur(14px) saturate(160%);
        -webkit-backdrop-filter: blur(14px) saturate(160%);
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        position: sticky;
        top: 0;
        z-index: 30;
      }

      .inst-topbar {
        background: var(--brand-primary);
        color: rgba(255, 255, 255, 0.92);
        font-size: 0.74rem;
        font-family: var(--font-mono);
        letter-spacing: 0.02em;
        padding: 0.38rem 1.25rem;
        border-bottom: 2px solid var(--brand-accent);
      }

      .inst-topbar-inner {
        max-width: 960px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .inst-header-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 0.95rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .inst-brand {
        display: flex;
        align-items: center;
        gap: 0.95rem;
      }

      .inst-badge {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        background: var(--brand-primary);
        color: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-weight: 700;
        border: 1.5px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 4px 12px rgba(52, 56, 170, 0.22);
        flex-shrink: 0;
      }

      .inst-badge span:first-child {
        font-size: 0.6rem;
        letter-spacing: 0.08em;
        color: #fde68a;
      }

      .inst-badge span:last-child {
        font-size: 1.02rem;
        line-height: 1.05;
      }

      .inst-title h1 {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-main);
        letter-spacing: -0.02em;
      }

      .inst-title p {
        font-size: 0.82rem;
        color: var(--text-muted);
      }

      .siu-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #ffffff;
        color: var(--brand-primary);
        border: 1px solid rgba(52, 56, 170, 0.22);
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.03em;
      }

      .siu-pill::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--brand-accent);
      }

      .main-container {
        max-width: 960px;
        margin: 1.6rem auto 3rem;
        padding: 0 1.25rem;
      }

      .inst-footer {
        max-width: 960px;
        margin: 2rem auto;
        padding: 1.25rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: 0.78rem;
        color: var(--text-muted);
      }

      .inst-footer-code {
        font-family: var(--font-mono);
        font-size: 0.72rem;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background: #ffffff !important;
          background-image: none !important;
        }
        .main-container {
          margin: 0;
          max-width: 100%;
          padding: 0;
        }
      }
    </style>
  </head>
  <body class={embed ? 'is-embed' : ''}>
    {
      !embed && (
        <header class="inst-header no-print">
          <div class="inst-topbar">
            <div class="inst-topbar-inner">
              <span>ISFT N° 191 // BAHÍA BLANCA — PROVINCIA DE BUENOS AIRES</span>
              <span>SECRETARÍA ACADÉMICA</span>
            </div>
          </div>
          <div class="inst-header-inner">
            <div class="inst-brand">
              <div class="inst-badge" aria-hidden="true">
                <span>ISFT</span>
                <span>191</span>
              </div>
              <div class="inst-title">
                <h1>Inscripción a Mesas Examinadoras Finales</h1>
                <p>Padrón curricular unificado de tecnicaturas superiores</p>
              </div>
            </div>
            <span class="siu-pill">HOMOLOGADO SIU GUARANÍ</span>
          </div>
        </header>
      )
    }

    <main class="main-container">
      <slot />
    </main>

    {
      !embed && (
        <footer class="inst-footer no-print">
          <p>
            ISFT N° 191 Bahía Blanca • Los datos registrados revisten carácter de Declaración Jurada.
          </p>
          <span class="inst-footer-code">SSR ENGINE // 8 CARRERAS • 211 ASIGNATURAS</span>
        </footer>
      )
    }
  </body>
</html>
